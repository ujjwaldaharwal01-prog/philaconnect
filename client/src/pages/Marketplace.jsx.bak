import { useMemo, useState } from 'react';
import StampCard from '../components/marketplace/StampCard';
import { stamps, CONDITIONS } from '../data/stamps';

const CATEGORIES = [...new Set(stamps.map((s) => s.category))];
const COUNTRIES = [...new Set(stamps.map((s) => s.country))];

export default function Marketplace() {
  const [search, setSearch] = useState('');
  const [category, setCategory] = useState('');
  const [country, setCountry] = useState('');
  const [condition, setCondition] = useState('');

  const filtered = useMemo(() => {
    return stamps.filter((s) => {
      const matchesSearch =
        !search ||
        s.name.toLowerCase().includes(search.toLowerCase()) ||
        s.country.toLowerCase().includes(search.toLowerCase());
      const matchesCategory = !category || s.category === category;
      const matchesCountry = !country || s.country === country;
      const matchesCondition = !condition || s.condition === condition;
      return matchesSearch && matchesCategory && matchesCountry && matchesCondition;
    });
  }, [search, category, country, condition]);

  return (
    <div className="bg-[#f5f0e6] min-h-screen">
      <div className="container-page py-10">
        <h1 className="font-serif text-4xl text-forest-900 mb-2">Marketplace</h1>
        <p className="text-forest-700/70 mb-8">Browse stamps from collectors around the world.</p>

        <div className="flex flex-col gap-3 sm:flex-row sm:flex-wrap mb-8">
          <input
            type="text"
            placeholder="Search by name or country..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="flex-1 min-w-[200px] rounded-md border border-forest-800/20 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500"
          />
          <select value={category} onChange={(e) => setCategory(e.target.value)} className="rounded-md border border-forest-800/20 px-3 py-2">
            <option value="">All Categories</option>
            {CATEGORIES.map((c) => <option key={c} value={c}>{c}</option>)}
          </select>
          <select value={country} onChange={(e) => setCountry(e.target.value)} className="rounded-md border border-forest-800/20 px-3 py-2">
            <option value="">All Countries</option>
            {COUNTRIES.map((c) => <option key={c} value={c}>{c}</option>)}
          </select>
          <select value={condition} onChange={(e) => setCondition(e.target.value)} className="rounded-md border border-forest-800/20 px-3 py-2">
            <option value="">All Conditions</option>
            {CONDITIONS.map((c) => <option key={c} value={c}>{c}</option>)}
          </select>
        </div>

        {filtered.length === 0 ? (
          <p className="text-center text-forest-700/60 py-20">No stamps match your filters.</p>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {filtered.map((stamp) => <StampCard key={stamp.id} stamp={stamp} />)}
          </div>
        )}
      </div>
    </div>
  );
}