import { Link } from 'react-router-dom';
import Logo from '../ui/Logo';

// Footer link groups. Kept as data so adding a link is a one-line change.
const GROUPS = [
  {
    title: 'Explore',
    links: [
      { label: 'Marketplace', to: '/marketplace' },
      { label: 'Recommendations', to: '/recommendations' },
      { label: 'Community', to: '/community' },
    ],
  },
  {
    title: 'Account',
    links: [
      { label: 'Login', to: '/login' },
      { label: 'Shopping cart', to: '/cart' },
    ],
  },
  {
    title: 'PHILAConnect',
    links: [{ label: 'About', to: '/about' }],
  },
];

/** Site footer with brand blurb, link groups and an academic-project note. */
export default function Footer() {
  return (
    <footer className="bg-forest-950 text-cream/80">
      <div className="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_2fr]">
        <div>
          <Logo light />
          <p className="mt-4 max-w-sm text-sm leading-relaxed text-cream/65">
            A smart digital home for philatelists: buy and sell stamps, meet fellow collectors and
            discover your next favourite issue with AI-assisted recommendations.
          </p>
        </div>

        <div className="grid grid-cols-2 gap-8 sm:grid-cols-3">
          {GROUPS.map((group) => (
            <div key={group.title}>
              <h3 className="font-display text-base font-semibold text-gold-300">{group.title}</h3>
              <ul className="mt-4 space-y-2.5 text-sm">
                {group.links.map((link) => (
                  <li key={link.to}>
                    <Link to={link.to} className="transition hover:text-gold-300">
                      {link.label}
                    </Link>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div className="border-t border-cream/10">
        <div className="container-page flex flex-col gap-2 py-6 text-xs text-cream/50 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} PHILAConnect. Final-year academic project.</p>
          <p>Listings and images shown are sample data for demonstration only.</p>
        </div>
      </div>
    </footer>
  );
}
